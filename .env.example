# Shared Ollama endpoint and model for Origin: AI World.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_TIMEOUT_SECONDS=20
DECISION_INTERVAL_SECONDS=1.2
# One simulated month takes one real minute. The spectator clock stays at 1x.
MONTH_LENGTH_SECONDS=60

# Natural event rates are evaluated per simulated month.
NATURAL_EVENT_PROBABILITY=0.01
DISEASE_EMERGENCE_PROBABILITY=0.002
MAX_SAVED_EVENTS=1000

# Optional path override; defaults to data/world.sqlite3 at the project root.
# AI_WORLD_DATABASE=data/world.sqlite3

# Comma-separated browser origins for the separately hosted frontend.
# FRONTEND_ORIGINS=http://localhost:5173,https://your-frontend.example
